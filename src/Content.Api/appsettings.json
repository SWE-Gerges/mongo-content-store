{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "IncludeScopes": true
    }
  },
  "AllowedHosts": "*",
  "Mongo": {
    "DefaultDatabase": "content",
    "ConnectTimeout": "00:00:05",
    "ServerSelectionTimeout": "00:00:05",
    "MaxConnectionPoolSize": 100,
    "BootstrapIndexes": true
  },
  "ContentStore": {
    "Suppliers": [ "supplier-a", "supplier-b", "supplier-c" ],
    "DefaultPageSize": 100,
    "MaxPageSize": 1000,
    "MaxIdsPerRequest": 500,
    "MaxSearchResults": 100,
    "SearchMaxTime": "00:00:05",
    "ReadMaxTime": "00:00:05"
  },
  "Reads": {
    "IndexTimeout": "00:00:01",
    "Routes": [
      { "Supplier": "supplier-a", "Collection": "hotel_supplier-a", "IndexAlias": "content-hotel_supplier-a" },
      { "Supplier": "supplier-b", "Collection": "hotel_supplier-b", "IndexAlias": "content-hotel_supplier-b" },
      { "Supplier": "supplier-c", "Collection": "hotel_supplier-c", "IndexAlias": "content-hotel_supplier-c" }
    ]
  },
  "IndexVersioning": {
    "RetainedVersions": 2,
    "CountTolerance": 0.001,
    "MaxDeadLetters": 100,
    "SampleSize": 25
  },
  "Coordination": {
    "LeaseDuration": "00:00:30",
    "HeartbeatInterval": "00:00:10"
  },
  "OpenSearch": {
    "IndexPrefix": "content-",
    "Shards": 1,
    "Replicas": 0,
    "RequestTimeout": "00:01:00"
  },
  "Sync": {
    "BatchSize": 5000,
    "InterBatchDelay": "00:00:00",
    "BulkChunkSize": 500,
    "BulkMaxParallelism": 2,
    "MaxReadAttempts": 5,
    "ReadBackoffBase": "00:00:01",
    "ReadBackoffCap": "00:01:00",
    "MaxBulkAttempts": 4,
    "BulkBackoffBase": "00:00:01",
    "BulkBackoffCap": "00:00:30",
    "ItemRetryDelay": "00:00:00.500"
  }
}
